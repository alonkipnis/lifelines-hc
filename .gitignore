# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
dist/
build/
.venv/
venv/

# OS
.DS_Store

# Regenerable analysis outputs
AppNote/figs/
AppNote/biology_report.html

# LaTeX build artifacts
*.aux
*.log
*.bbl
# arXiv does not run BibTeX, so the preprint build must ship its .bbl
!AppNote/paper/arxiv/main.bbl
*.blg
*.out
*.synctex.gz
*.toc

# arXiv submission tarball (regenerate from AppNote/paper/arxiv/)
AppNote/paper/arxiv/*.tar.gz

# SoftwareX build artifacts
AppNote/paper/softwarex/*.tar.gz

# R package build artifacts
R-package/*.tar.gz
R-package/*.Rcheck/
